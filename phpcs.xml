<?xml version="1.0"?>
<ruleset name="djot">
    <arg value="nps"/>

    <file>src/</file>
    <file>tests/</file>

    <rule ref="PhpCollective"/>

    <rule ref="SlevomatCodingStandard.Functions.RequireTrailingCommaInDeclaration"/>
    <rule ref="SlevomatCodingStandard.Functions.RequireTrailingCommaInClosureUse"/>

    <!-- Allow short attribute names since PhpCollective.Commenting.Attributes.ExpectedFQCN conflicts -->
    <rule ref="SlevomatCodingStandard.Namespaces.ReferenceUsedNamesOnly.ReferenceViaFullyQualifiedName">
        <exclude-pattern>tests/OfficialTestSuiteTest.php</exclude-pattern>
        <exclude-pattern>tests/FuzzTest.php</exclude-pattern>
    </rule>

</ruleset>
